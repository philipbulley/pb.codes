{
  "name": "pb.codes",
  "description": "Philip Bulley - Freelance front-end developer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Philip Bulley <philip@pb.codes>",
  "keywords": [
    "portfolio",
    "developer",
    "freelance",
    "london"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "react-router dev",
    "start": "npm run dev",
    "build": "react-router build",
    "preview": "sirv build/client --single __spa-fallback.html",
    "format": "prettier --write .",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "isbot": "^5.2.2",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,toml,webmanifest}": "prettier --write"
  }
}
